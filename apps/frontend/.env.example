# Gene Forge Analyzer - Frontend Environment Template
VITE_APP_NAME="Gene Forge Analyzer"
VITE_VERSION="2.0.0"

# API Configuration
# Use http://localhost:5000/api for local development without Docker
# Use /api if serving via Nginx proxy in Docker
VITE_API_URL=http://localhost:5000/api

# WebSocket Configuration
VITE_WS_URL=ws://localhost:5000

# Feature Flags
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_CRISPR_TOOLS=true
