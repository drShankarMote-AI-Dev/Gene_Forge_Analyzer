# ==========================================
# BACKEND ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env for local development
# For Render: Set these in the Render dashboard

# --- APP CONFIG ---
SECRET_KEY=dev-secret-key-change-this-in-prod
JWT_SECRET_KEY=jwt-secret-key-change-this-in-prod

# --- DATABASE ---
# For Production: Use PostgreSQL
# DATABASE_URL=postgresql://user:pass@host:5432/db
# For Development: Use SQLite
DATABASE_URL=sqlite:///geneforge.db

# --- ADMIN DEFAULTS ---
ADMIN_EMAIL=admin@geneforge.com
ADMIN_PASSWORD=admin123

# --- NETWORKING & CORS ---
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- PRODUCTION SECURITY ---
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax
NODE_ENV=development
FLASK_ENV=development

# --- GOOGLE OAUTH ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- EMAIL (SMTP) ---
# For Gmail: Use App Passwords (https://myaccount.google.com/apppasswords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@geneforge.com

# --- AI INTERPRETATION ENGINE ---
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
AI_GATEWAY_API_KEY=your-ai-gateway-key
