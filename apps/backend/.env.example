# Gene Forge Analyzer - Backend Environment Template

# --- SERVER CONFIG ---
FLASK_APP=app.py
FLASK_ENV=production
PORT=5000

# --- SECRETS ---
SECRET_KEY=dev-secret-key-change-this-in-prod
JWT_SECRET_KEY=jwt-secret-key-change-this-in-prod

# --- DATABASE ---
DATABASE_URL=sqlite:///geneforge.db

# --- ADMIN SEED ---
ADMIN_EMAIL=admin@geneforge.com
ADMIN_PASSWORD=admin123

# --- CORS ---
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- AI API KEYS ---
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# --- EMAIL ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
