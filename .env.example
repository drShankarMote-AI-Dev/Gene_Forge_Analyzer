# 🧬 Gene Forge Analyzer - Master Environment Template
# Copy this file to .env and fill in the values

# --- APP CONFIG ---
VITE_APP_NAME="Gene Forge Analyzer"
VITE_VERSION="2.0.0"
NODE_ENV=production # development | production
PORT=5000

# --- BACKEND SECRETS ---
# Generate these with: python -c "import os; print(os.urandom(32).hex())"
SECRET_KEY=dev-secret-key-change-this-in-prod
JWT_SECRET_KEY=jwt-secret-key-change-this-in-prod

# --- DATABASE ---
# SQLite: sqlite:///geneforge.db
# Postgres: postgresql://user:pass@host:port/dbname
DATABASE_URL=sqlite:///geneforge.db

# --- INITIAL ADMIN (Seeded on first run if missing) ---
ADMIN_EMAIL=admin@geneforge.com
ADMIN_PASSWORD=admin123

# --- CORS & ORIGINS ---
# Frontend URL for JWT cookie security and CORS
FRONTEND_URL=http://localhost:3000
# Comma-separated list for CORS whitelisting
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- AI INTERPRETATION ENGINE ---
# Provide at least one key for AI features to work
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# --- GOOGLE OAUTH ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- EMAIL (OTP & NOTIFICATIONS) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@geneforge.com

# --- DOCKER CONFIG ---
BACKEND_PORT=5000
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:5000/api
VITE_WS_URL=ws://localhost:5000
